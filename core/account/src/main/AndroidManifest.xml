<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Gives the account library the application context it stores the login tokens with.
            The library doesn't declare it itself; without it the tokens only live in memory, so
            the user is logged out whenever the app process is killed.
        -->
        <provider
            android:name="com.privateinternetaccess.account.AccountContentProvider"
            android:authorities="${applicationId}.account-context"
            android:exported="false" />
    </application>
</manifest>